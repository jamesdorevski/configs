_zsh_plugin_dirs=(
  ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/share}
  ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/opt/zsh-vi-mode/share}
  /usr/share
  /usr/share/zsh/plugins
  ${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins
)

_zsh_plugin() {
  local dir file
  for dir in $_zsh_plugin_dirs; do
    for file in $dir/$1/$1{.zsh,.plugin.zsh}; do
      [[ -r $file ]] && { REPLY=$file; return 0 }
    done
  done
  return 1
}

_zsh_plugin zsh-syntax-highlighting && source $REPLY
_zsh_plugin zsh-autosuggestions && source $REPLY
_zsh_plugin zsh-history-substring-search && source $REPLY
_zsh_plugin zsh-vi-mode && source $REPLY
